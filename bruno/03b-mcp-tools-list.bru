meta {
  name: 03b - MCP Discover Tools (tools/list)
  type: http
  seq: 3.1
}

post {
  url: {{base_url}}/mcp
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 101,
    "method": "tools/list",
    "params": {}
  }
}

tests {
  test("Discovers all 5 published MCP tools and their JSON Schemas", function() {
    expect(res.getStatus()).to.equal(200);
    const tools = res.getBody().result.tools;
    expect(tools).to.be.an("array");
    expect(tools.length).to.equal(5);
  });
}
