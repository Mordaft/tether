meta {
  name: 05 - Resource tether://sessions
  type: http
  seq: 5
}

post {
  url: {{base_url}}/mcp
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 3,
    "method": "resources/read",
    "params": {
      "uri": "tether://sessions"
    }
  }
}

tests {
  test("Returns isolated PTY session list for authenticated agent", function() {
    expect(res.getStatus()).to.equal(200);
    const contents = res.getBody().result.contents;
    const data = JSON.parse(contents[0].text);
    expect(data.agent_id).to.equal(bru.getEnvVar("agent_id"));
    expect(data.sessions).to.be.an("array");
  });
}
